{
  "manifest_version": 3,
  "name": "FlipMargin - eBay Profit & Comps CSV Exporter",
  "short_name": "FlipMargin",
  "version": "1.0.1",
  "description": "See estimated net payout, fees, and max buy price on eBay listings, and export search comps to CSV.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FlipMargin",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["ExtPay.js", "background.js"]
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://*.ebay.com/*"],
  "content_scripts": [
    {
      "matches": ["https://extensionpay.com/*"],
      "js": ["ExtPay.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.ebay.com/*"],
      "js": ["ExtPay.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "flipmargin@treborx.dev",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
